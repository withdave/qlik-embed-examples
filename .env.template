# Qlik Cloud Configuration
# Copy this file to .env and fill in your actual values

# Your Qlik Cloud tenant host (e.g., your-tenant.qlikcloud.com)
QLIK_HOST=your-tenant.qlikcloud.com

# OAuth client ID for anonymous access
QLIK_CLIENT_ID=your-client-id

# Access code for the anonymous app share
QLIK_ACCESS_CODE=your-access-code

# The Qlik Sense app ID to display
QLIK_APP_ID=your-app-id
